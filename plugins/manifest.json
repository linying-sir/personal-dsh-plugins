{
  "description": "Inventory used by scripts/install-profile.mjs. kind=path plugins are loaded from this repository by absolute path; kind=package plugins are installed with `dsh plugin add`.",
  "profile": "desktop",
  "plugins": [
    {
      "id": "ui-scale",
      "kind": "path",
      "dir": "ui-scale"
    },
    {
      "id": "wsl-badge",
      "kind": "path",
      "dir": "wsl-badge"
    },
    {
      "id": "collapse-groups",
      "kind": "path",
      "dir": "collapse-groups"
    },
    {
      "id": "electron-env",
      "kind": "path",
      "dir": "electron-env"
    },
    {
      "name": "dsh-wsl-workspace",
      "kind": "package",
      "version": "0.7.8",
      "bundle": true
    }
  ]
}
